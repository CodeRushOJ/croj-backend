SPRING_PROFILES_ACTIVE=dev
TMPDIR=/tmp
FILE_UPLOAD_DIR=/app/uploads
DATABASE_URL=jdbc:mysql://localhost:3306/code_rush_oj?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false
DATABASE_USERNAME=coderushoj
DATABASE_PASSWORD=replace-with-generated-value
REDIS_PASSWORD=replace-with-generated-value
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=replace-with-at-least-32-random-bytes
JUDGE_RESULT_SERVICE_TOKEN=replace-with-at-least-32-random-bytes
CORS_ALLOWED_ORIGINS=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=noreply@coderushoj.local
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
SUBMISSION_TOPIC=submission-topic
OUTBOX_ENABLED=true
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL=PT1S
OUTBOX_CLAIM_TIMEOUT=PT30S
OUTBOX_PUBLISH_TIMEOUT=PT5S
TEST_BUNDLE_STORAGE_ENABLED=true
TEST_BUNDLE_S3_BUCKET=coderushoj-test-bundles
TEST_BUNDLE_S3_ENDPOINT=http://localhost:9000
TEST_BUNDLE_S3_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-minio-access-key
AWS_SECRET_ACCESS_KEY=replace-with-minio-secret-key
TEST_BUNDLE_MAX_ARCHIVE_BYTES=268435456
TEST_BUNDLE_MAX_MANIFEST_BYTES=1048576
TEST_BUNDLE_MAX_CASE_BYTES=66060288
TEST_BUNDLE_MAX_UNCOMPRESSED_BYTES=66060288
TEST_BUNDLE_MAX_CASES=256
TEST_BUNDLE_MAX_COMPRESSION_RATIO=200
IMPORT_MAX_FILE_SIZE=256MB
IMPORT_MAX_REQUEST_SIZE=260MB

